// Cloudflare Workers 배포 설정 (회사망용 보조 주소).
// GitHub에 push될 때마다(매일 자동 수집 커밋 포함) Cloudflare가 다시 배포한다.
// 정적 파일은 assets로 내주고, /api/gdelt만 worker/index.js가 처리한다(GDELT 하루 1회 대리 요청).
{
  "name": "pb-observatory",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
